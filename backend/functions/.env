# Deploy-time params for the functions codebase (see src/secrets.ts).
#
# Neither value is a secret — the real one, RESEND_API_KEY, lives in Secret
# Manager via `firebase functions:secrets:set`. These are here so a deploy is
# reproducible and doesn't stop to prompt; without the file the CLI asks for
# them interactively and fails outright in any non-interactive shell.

# The domain here MUST be verified at https://resend.com/domains or Resend
# rejects every send with a 403 and the mail is silently never delivered.
RESEND_FROM_EMAIL=Love Inc Global <LoveInc@asera.tech>

# Public origin of the frontend, no trailing slash, e.g. https://lovegate.vercel.app
# Empty is what production currently runs; while it's empty, emails resolve no
# flyer artwork and ticket links stay relative.
SITE_URL=https://love-gate.vercel.app

